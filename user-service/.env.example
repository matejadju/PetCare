PORT=8001
NODE_ENV=development

# PostgreSQL
POSTGRES_PASSWORD=your_database_password
DATABASE_URL="postgresql://petcare_user:your_database_password@localhost:5433/petcare_users?schema=public"

# JWT
JWT_SECRET=your_shared_jwt_secret
JWT_ISSUER=petcare-user-service
JWT_AUDIENCE=petcare-api
JWT_EXPIRES_IN=1h

# Microservice communication
APPOINTMENT_SERVICE_URL=http://localhost:8004
APPOINTMENT_SERVICE_TIMEOUT_MS=5000